# DATABASE
DATABASE_URL=sqlite:///./scholargraph.db

# LLM Configuration (Choose Ollama for local or Groq for high-speed cloud inference)
# --- Option A: Groq (Recommended for fast cloud processing) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_SECONDS=600

# --- Option B: Ollama (Local open-source models) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=sk-placeholder
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# GROBID
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT_SECONDS=120

# ACADEMIC APIS
ACADEMIC_API_TIMEOUT_SECONDS=30
ACADEMIC_API_MAX_RETRIES=2

# LITERATURE
MAX_RELATED_PAPERS_PER_QUERY=30
MAX_TOTAL_RELATED_PAPERS=100
MAX_DETAILED_ANALYSIS_PAPERS=10
LITERATURE_ANALYSIS_CONCURRENCY=2
MAX_GAP_ANALYSIS_PAPERS=10
MAX_RESEARCH_GAPS=10
RECENT_RESEARCH_YEARS=5
MAX_RECENT_RESEARCH_QUERIES=5
MAX_RECENT_RESULTS_PER_QUERY=20
MAX_RECENT_RESEARCH_PAPERS=30
MAX_RECENT_LLM_ANALYSIS=10

# EXPORT
EXPORT_MAX_RELATED_PAPERS=50
EXPORT_MAX_ANALYSES=20
EXPORT_MAX_RECENT_RESEARCH=50
EXPORT_MAX_RESEARCH_GAPS=20

# UPLOAD
MAX_UPLOAD_SIZE_MB=25

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://researchpaperlens.vercel.app

# TIMEOUTS
API_TIMEOUT_SECONDS=30
